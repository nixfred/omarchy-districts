{
  "schemaVersion": 1,
  "id": "nixfred.districts",
  "name": "Districts",
  "version": "3.0.0",
  "author": "Fred Nix",
  "license": "MIT",
  "description": "Orbit your real desktop city, inspect actual session families and owner resources, and preview safe window organization.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "v3.0.0/DistrictsV2.qml"
  },
  "barWidget": {
    "displayName": "Districts",
    "category": "Desktop",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "motion": true,
      "night": true,
      "edgePan": true,
      "storedAgents": false
    },
    "schema": [
      {
        "key": "motion",
        "type": "boolean",
        "label": "Living city motion",
        "defaultValue": true
      },
      {
        "key": "night",
        "type": "boolean",
        "label": "Night city",
        "defaultValue": true
      },
      {
        "key": "edgePan",
        "type": "boolean",
        "label": "Edge glide",
        "defaultValue": true
      },
      {
        "key": "storedAgents",
        "type": "boolean",
        "label": "Show stored agent sessions",
        "defaultValue": false
      }
    ]
  }
}
